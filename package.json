{
  "name": "jira-sprinter",
  "version": "2.6.0",
  "description": "Small CLI tool to manage sprints in JIRA Board",
  "main": "src/main.ts",
  "type": "commonjs",
  "bin": "./dist/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "esbuild ./src/main.js --bundle --outdir=dist --platform=node --target=node20.0.0 --packages=bundle --external:kerberos",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "test": "vitest run --coverage",
    "update-snapshots": "vitest run --update",
    "all": "yarn && yarn run build && yarn run format && yarn test"
  },
  "packageManager": "yarn@4.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-plumbers-in-action/sprinter.git"
  },
  "author": "jamacku@redhat.com",
  "license": "GPL-3.0+",
  "bugs": {
    "url": "https://github.com/redhat-plumbers-in-action/sprinter/issues"
  },
  "homepage": "https://github.com/redhat-plumbers-in-action/sprinter#readme",
  "keywords": [
    "cli",
    "jira",
    "agile",
    "scrum"
  ],
  "dependencies": {
    "@inquirer/checkbox": "5.2.5",
    "@inquirer/select": "5.2.5",
    "@total-typescript/ts-reset": "0.6.1",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "jira.js": "5.4.0",
    "kerberos": "7.0.0",
    "product-pages": "1.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
